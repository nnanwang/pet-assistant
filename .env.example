# Server only. Never prefix provider API keys with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
API_PORT=8787
# Use 0.0.0.0 only for a trusted local network / physical device testing.
API_HOST=127.0.0.1
# Native device: point this to the computer's LAN IP or your HTTPS server.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
# Browser origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
# Required in NODE_ENV=production; enter this token in the app's Connection settings.
# API_ACCESS_TOKEN=
